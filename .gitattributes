# Normalize all text files to LF in the repo and on checkout, on every OS.
# This overrides the machine-level core.autocrlf (which on Windows defaults to
# `true` and silently rewrites files to CRLF). Pinning eol=lf keeps diffs clean
# and deterministic across Windows / macOS / Linux / CI.
* text=auto eol=lf

# Source & config — always LF
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.jsx  text eol=lf
*.mjs  text eol=lf
*.cjs  text eol=lf
*.json text eol=lf
*.css  text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.md   text eol=lf
*.mdx  text eol=lf
*.sql  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.env  text eol=lf
*.sh   text eol=lf

# Lockfiles — LF, and don't show massive diffs in review
pnpm-lock.yaml text eol=lf -diff
package-lock.json text eol=lf -diff

# Binary assets — never touch line endings
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.mp4  binary
*.mov  binary
*.webm binary
*.woff  binary
*.woff2 binary
*.ttf  binary
*.otf  binary
*.pdf  binary

# SVGs are text but treat as binary for diffs (they're usually generated/minified)
*.svg  text eol=lf
